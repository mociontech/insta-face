# Insta Face · DevOps Days Bogotá 2026. Copiar a .env.local (ignorado por git). Solo NEXT_PUBLIC_* llega al navegador.
NEXT_PUBLIC_API_URL=

# Evius (Datahub). Sin estas variables el envío a Evius queda apagado. En Netlify/Vercel, cargarlas como variables del sitio.
NEXT_PUBLIC_EVIUS_URL=
NEXT_PUBLIC_EVIUS_TOKEN=
NEXT_PUBLIC_EVIUS_EVENT_ID=
NEXT_PUBLIC_EVIUS_EXPERIENCE_ID=
NEXT_PUBLIC_EVIUS_SOURCE=
